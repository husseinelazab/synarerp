# إصدار شهادات مواقع الجمعيات (نطاقاتها المستقلة .sa) عند أول زيارة، بعد التأكد من سِينار أن النطاق مسجل ومنشور
{
	on_demand_tls {
		ask http://web:8000/site-domain-check/
	}
}

# Caddy يصدر شهادة HTTPS مجانية تلقائياً (Let's Encrypt) للنطاق ويجددها قبل انتهائها
{$SYNAR_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8000
	request_body {
		max_size 20MB
	}
	header {
		-Server
	}
}

# HTTP: تحويل كل شيء إلى HTTPS، عدا مسارات أجهزة البصمة (كثير منها لا يدعم HTTPS ولا يتبع التحويل)
http://{$SYNAR_DOMAIN} {
	handle /iclock/* {
		reverse_proxy web:8000
	}
	handle {
		redir https://{host}{uri} 308
	}
}

# مواقع الجمعيات على نطاقاتها المستقلة (مثل albirr.org.sa و www.albirr.org.sa)
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy web:8000
	request_body {
		max_size 20MB
	}
	header {
		-Server
	}
}

http:// {
	redir https://{host}{uri} 308
}
