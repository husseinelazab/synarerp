# ===== إعدادات تشغيل سِينار في الإنتاج =====
# انسخ هذا الملف إلى .env وعدّل القيم:  cp .env.example .env
# لا ترفع ملف .env إلى أي مستودع؛ فيه أسرار.

# النطاق الذي سيعمل عليه النظام (وجّه سجل DNS من نوع A إلى عنوان الخادم أولاً)
SYNAR_DOMAIN=erp.example.com
SYNAR_ALLOWED_HOSTS=erp.example.com
SYNAR_CSRF_TRUSTED_ORIGINS=https://erp.example.com
SYNAR_SITE_URL=https://erp.example.com

# مفتاح سري طويل وعشوائي — ولّده بـ:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# لا تغيّره بعد التشغيل: تتعطل به مفاتيح الفوترة الإلكترونية وكلمة مرور البريد المحفوظة
SYNAR_SECRET_KEY=

SYNAR_DEBUG=0

# قاعدة البيانات (PostgreSQL داخل docker compose)
SYNAR_DB_NAME=synar
SYNAR_DB_USER=synar
SYNAR_DB_PASSWORD=

# مدير المنصة يُنشأ عند أول تشغيل (غيّر كلمة المرور بعد الدخول، ثم يمكنك حذف السطرين)
SYNAR_ADMIN_USER=admin
SYNAR_ADMIN_PASSWORD=

# أداء الخادم: عدد العمليات (2 × عدد الأنوية + 1 تقريباً)
SYNAR_WORKERS=3
SYNAR_THREADS=2

# النسخ الاحتياطي: الساعة اليومية (بتوقيت الرياض) وعدد أيام الاحتفاظ؛ النسخ في مجلد backups/
SYNAR_BACKUP_HOUR=2
SYNAR_BACKUP_KEEP_DAYS=14
# كلمة سر تشفير النسخ الاحتياطية (AES-256). احفظها خارج الخادم: بدونها لا يمكن استعادة أي نسخة
# أنشئ واحدة قوية بالأمر: openssl rand -base64 32
SYNAR_BACKUP_PASSPHRASE=
# رفع النسخ (مشفّرة) ومعها المرفقات إلى تخزين خارج الخادم: وجهة rclone، وبياناتها في deploy/offsite.env
# SYNAR_BACKUP_REMOTE=offsite:synar-backups
# SYNAR_BACKUP_REMOTE_KEEP_DAYS=30

# ساعة إرسال تنبيهات الموارد البشرية اليومية
SYNAR_REMINDERS_HOUR=7

# النظام خلف Caddy فيُؤخذ عنوان العميل من X-Forwarded-For (لحد محاولات الدخول وسجل التدقيق).
# اجعلها 0 فقط إن عرضت التطبيق مباشرة بلا وكيل عكسي، وإلا أمكن تزوير العنوان
# SYNAR_TRUST_PROXY=1

# أقصى عدد للحسابات الجديدة من عنوان IP واحد في اليوم (حماية صفحة التسجيل من البرامج الآلية)
# SYNAR_SIGNUP_LIMIT=5

# القوائم المنسدلة التي يزيد عدد خياراتها عن هذا الرقم (العملاء، الأصناف...) تُبحث على الخادم أثناء الكتابة
# SYNAR_REMOTE_SELECT_THRESHOLD=300

# ملف توثيق Apple Pay لنطاق المنصة (اختياري؛ مواقع الجمعيات على نطاقاتها ترفع ملفها من إعدادات المتجر)
# SYNAR_APPLE_PAY_DOMAIN_FILE=/app/media/apple-developer-merchantid-domain-association

# مدة الجلسة بالساعات قبل طلب تسجيل الدخول من جديد
SYNAR_SESSION_HOURS=12

# معلومات الدفع والدعم الظاهرة للعملاء في صفحة الاشتراك
SYNAR_BILLING_INSTRUCTIONS=
SYNAR_SUPPORT_CONTACT=

# خادم البريد: الأفضل ضبطه من الواجهة «إدارة المنصة ← خادم البريد». الحقول هنا بديل اختياري.
# SYNAR_EMAIL_HOST=
# SYNAR_EMAIL_PORT=587
# SYNAR_EMAIL_USER=
# SYNAR_EMAIL_PASSWORD=
# SYNAR_EMAIL_FROM=

# غيّره مع كل تحديث للنظام لتحدّث أجهزة نقاط البيع ملفات الشاشة المخزنة للعمل دون اتصال
SYNAR_POS_CACHE_VERSION=1
